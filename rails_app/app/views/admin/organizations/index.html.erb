<section class="rounded-xl border border-slate-200 bg-white p-5 shadow">
  <h2 class="text-sm font-semibold text-slate-800">Organizations</h2>
  <%= form_with url: admin_organizations_path, method: :get, local: true, class: "mt-3 flex flex-wrap items-end gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search name…", class: "min-w-[12rem] rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    <%= submit_tag "Search", class: "cursor-pointer rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
  <% end %>

  <div class="mt-4 overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead>
        <tr class="border-b text-xs font-semibold uppercase text-slate-500">
          <th class="py-2 pr-4">Name</th>
          <th class="py-2 pr-4">Importer ID</th>
          <th class="py-2 pr-4">Portal</th>
          <th class="py-2 pr-4">Limit</th>
          <th class="py-2 text-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @organizations.each do |org| %>
          <tr class="border-b border-slate-100 last:border-0">
            <td class="py-2 pr-4 font-medium"><%= org.name %></td>
            <td class="py-2 pr-4 text-slate-600"><%= org.importer_external_id.presence || "—" %></td>
            <td class="py-2 pr-4"><%= org.portal_status.titleize %></td>
            <td class="py-2 pr-4"><%= number_to_currency(org.credit_limit_cents.to_d / 100, unit: "$") %></td>
            <td class="py-2 text-right">
              <%= link_to "Open ›", admin_organization_path(org), class: "font-semibold text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @organizations.empty? %>
    <p class="mt-4 text-sm text-slate-500">No organizations match.</p>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="mt-4 flex flex-wrap gap-2 text-sm">
      <% (1..@total_pages).each do |p| %>
        <% if p == @page %>
          <span class="rounded border border-slate-300 px-2 py-1 font-semibold"><%= p %></span>
        <% else %>
          <%= link_to p, admin_organizations_path(q: params[:q], page: p), class: "rounded border border-slate-200 px-2 py-1 text-emerald-700 hover:bg-slate-50" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
