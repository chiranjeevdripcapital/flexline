<% o = @organization %>
<section class="space-y-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <p class="text-xs font-semibold uppercase text-slate-500">Organization</p>
    <h2 class="text-xl font-bold text-slate-900"><%= o.name %></h2>
    <dl class="mt-4 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
      <div><dt class="text-slate-500">Importer ID</dt><dd class="font-medium"><%= o.importer_external_id.presence || "—" %></dd></div>
      <div><dt class="text-slate-500">Portal status</dt><dd class="font-medium"><%= o.portal_status.titleize %></dd></div>
      <div><dt class="text-slate-500">Credit limit</dt><dd class="font-medium"><%= number_to_currency(o.credit_limit_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Available (stored)</dt><dd class="font-medium"><%= number_to_currency(o.available_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Outstanding principal (scheduled)</dt><dd class="font-medium"><%= number_to_currency(o.outstanding_principal_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Available for new draws</dt><dd class="font-medium"><%= number_to_currency(o.available_for_draws_cents.to_d / 100, unit: "$") %></dd></div>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Bank accounts</h3>
    <% if o.bank_accounts.any? %>
      <ul class="mt-3 space-y-2 text-sm">
        <% o.bank_accounts.order(primary_for_disbursement: :desc, created_at: :desc).each do |a| %>
          <li class="flex flex-wrap justify-between gap-2 border-b border-slate-100 py-2 last:border-0">
            <span><%= a.display_name %> · ···<%= a.mask_last4 %></span>
            <span class="text-slate-600"><%= a.verification_status.titleize %> · <%= a.verification_method&.titleize || "—" %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">No bank accounts.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Recent draws</h3>
    <% if @recent_draws.any? %>
      <ul class="mt-3 space-y-2 text-sm">
        <% @recent_draws.each do |d| %>
          <li class="flex flex-wrap justify-between gap-2 border-b border-slate-100 py-2 last:border-0">
            <%= link_to d.public_code, admin_draw_path(d), class: "font-semibold text-emerald-700 hover:underline" %>
            <span><%= number_to_currency(d.amount_cents.to_d / 100, unit: "$") %> · <%= d.term_months %> mo · <%= d.status.titleize %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">No draws.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Recent admin events</h3>
    <% if @admin_events.any? %>
      <ul class="mt-3 space-y-2 text-xs text-slate-600">
        <% @admin_events.each do |e| %>
          <li class="border-b border-slate-100 py-2 last:border-0">
            <span class="font-semibold text-slate-800"><%= e.action %></span>
            · <%= e.actor_identifier %>
            · <%= l(e.created_at, format: :short) %>
            <% if e.draw_id %>
              · <%= link_to "Draw ##{e.draw_id}", admin_draw_path(e.draw_id), class: "text-emerald-700 hover:underline" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">No events yet.</p>
    <% end %>
  </div>

  <%= link_to "← Organizations", admin_organizations_path, class: "text-sm font-semibold text-emerald-700 hover:underline" %>
</section>
