<% d = @draw %>
<% o = d.organization %>
<section class="space-y-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <p class="text-xs font-semibold uppercase text-slate-500">Draw</p>
    <h2 class="text-xl font-bold text-slate-900"><%= d.public_code %></h2>
    <dl class="mt-4 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
      <div><dt class="text-slate-500">Company</dt><dd class="font-medium"><%= o.name %></dd></div>
      <div><dt class="text-slate-500">Importer ID</dt><dd class="font-medium"><%= o.importer_external_id.presence || "—" %></dd></div>
      <div><dt class="text-slate-500">Amount</dt><dd class="font-medium"><%= number_to_currency(d.amount_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Term</dt><dd class="font-medium"><%= d.term_months %> months</dd></div>
      <div><dt class="text-slate-500">Status</dt><dd class="font-medium"><%= d.status.titleize %></dd></div>
      <div><dt class="text-slate-500">Bank (disbursement)</dt><dd class="font-medium"><%= d.bank_account.display_name %> · ···<%= d.bank_account.mask_last4 %></dd></div>
      <% if d.internal_decline_code.present? %>
        <div class="sm:col-span-2">
          <dt class="text-slate-500">Internal decline code</dt>
          <dd class="font-medium"><%= d.internal_decline_code %> — <%= Draw::INTERNAL_DECLINE_CODES[d.internal_decline_code] %></dd>
        </div>
      <% end %>
    </dl>
    <% if d.status == "declined" && d.decline_reason.present? %>
      <p class="mt-4 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-900"><strong>Borrower-facing reason:</strong> <%= d.decline_reason %></p>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Company snapshot</h3>
    <dl class="mt-3 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
      <div><dt class="text-slate-500">Portal status</dt><dd class="font-medium"><%= o.portal_status.titleize %></dd></div>
      <div><dt class="text-slate-500">Credit limit</dt><dd class="font-medium"><%= number_to_currency(o.credit_limit_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Available (stored)</dt><dd class="font-medium"><%= number_to_currency(o.available_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Outstanding principal (scheduled)</dt><dd class="font-medium"><%= number_to_currency(o.outstanding_principal_cents.to_d / 100, unit: "$") %></dd></div>
      <div><dt class="text-slate-500">Available for new draws</dt><dd class="font-medium"><%= number_to_currency(o.available_for_draws_cents.to_d / 100, unit: "$") %></dd></div>
    </dl>
    <%= link_to "Organization page ›", admin_organization_path(o), class: "mt-3 inline-block text-sm font-semibold text-emerald-700 hover:underline" %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Operator notes (internal)</h3>
    <%= form_with model: d, url: update_notes_admin_draw_path(d), method: :patch, local: true, class: "mt-3 space-y-2" do |f| %>
      <%= f.text_area :operator_notes, rows: 4, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm", placeholder: "Visible to operations only—not shown to the borrower." %>
      <%= f.submit "Save notes", class: "cursor-pointer rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
    <% end %>
  </div>

  <% if d.status == "processing" %>
    <div class="space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow">
      <h3 class="text-sm font-semibold text-slate-800">Decision</h3>
      <div class="flex flex-wrap gap-3">
        <%= button_to "Approve & fund (creates schedule)", approve_admin_draw_path(d), method: :post, class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700" %>
      </div>
      <%= form_with url: decline_admin_draw_path(d), method: :post, local: true, class: "space-y-2 border-t border-slate-100 pt-4" do %>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500">Internal decline reason (required)</label>
          <%= select_tag :internal_decline_code,
            options_for_select([ [ "Select…", "" ] ] + Draw::INTERNAL_DECLINE_CODES.map { |code, label| [ "#{label} (#{code})", code ] }),
            class: "mt-1 w-full max-w-md rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500">Borrower-facing message</label>
          <%= text_area_tag :decline_reason, nil, rows: 2, placeholder: "Shown to the customer (keep professional).", class: "mt-1 w-full max-w-xl rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <%= submit_tag "Decline draw", class: "cursor-pointer rounded-lg border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-900 hover:bg-rose-100" %>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Instalments</h3>
    <% if d.installments.any? %>
      <ul class="mt-3 space-y-2 text-sm">
        <% d.installments.order(:sequence).each do |i| %>
          <li class="flex justify-between border-b border-slate-100 py-2 last:border-0">
            <span><%= l(i.due_on) %></span>
            <span class="font-medium"><%= number_to_currency(i.amount_cents.to_d / 100, unit: "$") %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">No instalments until funded.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <h3 class="text-sm font-semibold text-slate-800">Recent admin events</h3>
    <% if @admin_events.any? %>
      <ul class="mt-3 space-y-2 text-xs text-slate-600">
        <% @admin_events.each do |e| %>
          <li class="border-b border-slate-100 py-2 last:border-0">
            <span class="font-semibold text-slate-800"><%= e.action %></span>
            · <%= e.actor_identifier %>
            · <%= l(e.created_at, format: :short) %>
            <% if e.metadata.present? %>
              <pre class="mt-1 overflow-x-auto rounded bg-slate-50 p-2 text-[0.65rem]"><%= JSON.pretty_generate(e.metadata) %></pre>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">No events for this draw yet.</p>
    <% end %>
  </div>

  <%= link_to "← Draw queue", admin_draws_path, class: "text-sm font-semibold text-emerald-700 hover:underline" %>
</section>
