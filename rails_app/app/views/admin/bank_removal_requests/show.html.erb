<% r = @request %>
<% a = r.bank_account %>
<section class="space-y-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow">
    <p class="text-xs font-semibold uppercase text-slate-500">Bank removal request #<%= r.id %></p>
    <h2 class="text-xl font-bold text-slate-900"><%= r.organization.name %></h2>
    <p class="mt-1 text-sm text-slate-600"><%= a.display_name %> · ···<%= a.mask_last4 %> · <%= a.account_type.titleize %></p>
    <p class="mt-2">
      <span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= r.status == "pending_review" ? "border-amber-200 bg-amber-50 text-amber-950" : "border-slate-200 bg-slate-50 text-slate-800" %>">
        <%= r.status.titleize.tr("_", " ") %>
      </span>
    </p>
    <dl class="mt-4 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <dt class="text-slate-500">Borrower reason</dt>
        <dd class="mt-1 whitespace-pre-wrap font-medium"><%= r.borrower_reason %></dd>
      </div>
      <% if r.reviewer_identifier.present? %>
        <div><dt class="text-slate-500">Reviewer</dt><dd class="font-medium"><%= r.reviewer_identifier %></dd></div>
        <div><dt class="text-slate-500">Reviewed at</dt><dd class="font-medium"><%= r.reviewed_at ? l(r.reviewed_at, format: :short) : "—" %></dd></div>
      <% end %>
      <% if r.operator_notes.present? %>
        <div class="sm:col-span-2">
          <dt class="text-slate-500">Operator notes</dt>
          <dd class="mt-1 whitespace-pre-wrap"><%= r.operator_notes %></dd>
        </div>
      <% end %>
    </dl>
    <%= link_to "Organization ›", admin_organization_path(r.organization), class: "mt-3 inline-block text-sm font-semibold text-emerald-700 hover:underline" %>
  </div>

  <% if r.pending_review? %>
    <div class="grid gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow sm:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold text-emerald-800">Approve (after risk review)</h3>
        <p class="mt-1 text-xs text-slate-600">Marks the account <strong>removed</strong> in the portal. Another verified account must still exist (checked again on submit).</p>
        <%= form_with url: approve_admin_bank_removal_request_path(r), method: :post, local: true, class: "mt-3 space-y-2" do %>
          <%= text_area_tag :operator_notes, nil, rows: 2, placeholder: "Internal notes (optional)", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          <%= submit_tag "Approve removal", class: "cursor-pointer rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
        <% end %>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-rose-900">Reject</h3>
        <p class="mt-1 text-xs text-slate-600">Borrower keeps this verified account; document why if helpful.</p>
        <%= form_with url: reject_admin_bank_removal_request_path(r), method: :post, local: true, class: "mt-3 space-y-2" do %>
          <%= text_area_tag :operator_notes, nil, rows: 2, placeholder: "Internal notes (optional)", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          <%= submit_tag "Reject request", class: "cursor-pointer rounded-lg border border-rose-300 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-900 hover:bg-rose-100" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= link_to "← All removal requests", admin_bank_removal_requests_path, class: "text-sm font-semibold text-emerald-700 hover:underline" %>
</section>
