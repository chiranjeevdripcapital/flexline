<section class="rounded-xl border border-slate-200 bg-white p-5 shadow">
  <h2 class="text-sm font-semibold text-slate-800">Bank removal requests</h2>
  <%= form_with url: admin_bank_removal_requests_path, method: :get, local: true, class: "mt-3 flex flex-wrap items-end gap-2" do %>
    <%= select_tag :status,
      options_for_select([ [ "All statuses", "" ] ] + BankRemovalRequest::STATUSES.map { |s| [ s.titleize.tr("_", " "), s ] }, params[:status]),
      class: "rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
    <%= submit_tag "Filter", class: "cursor-pointer rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
  <% end %>

  <div class="mt-4 overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead>
        <tr class="border-b text-xs font-semibold uppercase text-slate-500">
          <th class="py-2 pr-4">Submitted</th>
          <th class="py-2 pr-4">Company</th>
          <th class="py-2 pr-4">Account</th>
          <th class="py-2 pr-4">Status</th>
          <th class="py-2 text-right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @requests.each do |r| %>
          <tr class="border-b border-slate-100 last:border-0">
            <td class="py-2 pr-4 text-slate-600"><%= l(r.created_at, format: :short) %></td>
            <td class="py-2 pr-4"><%= r.organization.name %></td>
            <td class="py-2 pr-4"><%= r.bank_account.display_name %> · ···<%= r.bank_account.mask_last4 %></td>
            <td class="py-2 pr-4"><%= r.status.titleize.tr("_", " ") %></td>
            <td class="py-2 text-right">
              <%= link_to "Review ›", admin_bank_removal_request_path(r), class: "font-semibold text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @requests.empty? %>
    <p class="mt-4 text-sm text-slate-500">No requests match.</p>
  <% end %>
</section>
