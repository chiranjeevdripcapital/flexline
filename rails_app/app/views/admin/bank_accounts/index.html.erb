<section class="rounded-xl border border-slate-200 bg-white p-5 shadow">
  <h2 class="text-sm font-semibold text-slate-800">Bank accounts (all organizations)</h2>

  <%= form_with url: admin_bank_accounts_path, method: :get, local: true, class: "mt-3 flex flex-wrap items-end gap-3" do %>
    <div>
      <label class="block text-xs font-semibold uppercase text-slate-500">Verification status</label>
      <%= select_tag :verification_status,
        options_for_select([ [ "Any", "" ] ] + BankAccount::VERIFICATION_STATUSES.map { |s| [ s.titleize, s ] }, params[:verification_status]),
        class: "mt-1 rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase text-slate-500">Method</label>
      <%= select_tag :verification_method,
        options_for_select([ [ "Any", "" ] ] + BankAccount::VERIFICATION_METHODS.map { |m| [ m.titleize.tr("_", " "), m ] }, params[:verification_method]),
        class: "mt-1 rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase text-slate-500">Organization</label>
      <%= text_field_tag :org_q, params[:org_q], placeholder: "Name contains…", class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <%= submit_tag "Apply", class: "cursor-pointer rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
    <%= link_to "Clear", admin_bank_accounts_path, class: "text-sm font-semibold text-emerald-700 hover:underline" %>
  <% end %>

  <p class="mt-2 text-xs text-slate-500">Showing <%= @bank_accounts.size %> of <%= @total_count %> (newest first).</p>

  <div class="mt-4 overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead>
        <tr class="border-b text-xs font-semibold uppercase text-slate-500">
          <th class="py-2 pr-4">Organization</th>
          <th class="py-2 pr-4">Label</th>
          <th class="py-2 pr-4">Mask</th>
          <th class="py-2 pr-4">Status</th>
          <th class="py-2 pr-4">Method</th>
          <th class="py-2 pr-4">Created</th>
        </tr>
      </thead>
      <tbody>
        <% @bank_accounts.each do |a| %>
          <tr class="border-b border-slate-100 last:border-0">
            <td class="py-2 pr-4"><%= a.organization.name %></td>
            <td class="py-2 pr-4"><%= a.display_name %></td>
            <td class="py-2 pr-4">···<%= a.mask_last4 %></td>
            <td class="py-2 pr-4"><%= a.verification_status.titleize %></td>
            <td class="py-2 pr-4"><%= a.verification_method&.titleize || "—" %></td>
            <td class="py-2 pr-4 text-slate-600"><%= l(a.created_at.to_date) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @bank_accounts.empty? %>
    <p class="mt-4 text-sm text-slate-500">No bank accounts match.</p>
  <% end %>
</section>
