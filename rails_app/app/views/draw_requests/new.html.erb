<div class="mx-auto max-w-2xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-flexline-navy">Request draw</h1>
    <p class="mt-1 text-sm text-flexline-muted">
      Enter an amount within your available limit, pick a term, and review the illustrative
      schedule before confirming.
    </p>
  </div>

  <%= form_with url: draw_requests_path, method: :post, local: true, class: "space-y-5 rounded-xl border border-flexline-border bg-white p-6 shadow-card" do %>
    <div>
      <label for="amount" class="block text-xs font-semibold uppercase tracking-wide text-flexline-muted">Draw amount (USD)</label>
      <input
        id="amount"
        name="amount"
        type="text"
        value="25000"
        class="mt-1 w-full rounded-lg border border-flexline-border px-3 py-2.5 text-sm font-medium text-flexline-navy outline-none ring-flexline-green focus:ring-2"
      />
      <p class="mt-1 text-xs text-flexline-muted">
        Available for draw: <span class="font-semibold">$87,500</span> (demo)
      </p>
    </div>

    <fieldset>
      <legend class="text-xs font-semibold uppercase tracking-wide text-flexline-muted">Term</legend>
      <div class="mt-2 flex gap-3">
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-flexline-navy bg-flexline-navy px-4 py-2 text-sm font-semibold text-white">
          <input type="radio" name="term" value="6" checked class="sr-only" />
          6 months
        </label>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-flexline-border px-4 py-2 text-sm font-semibold text-flexline-navy hover:bg-flexline-sidebar">
          <input type="radio" name="term" value="3" class="sr-only" />
          3 months
        </label>
      </div>
    </fieldset>

    <div>
      <label for="bank" class="block text-xs font-semibold uppercase tracking-wide text-flexline-muted">Disbursement account</label>
      <select
        id="bank"
        name="bank"
        class="mt-1 w-full rounded-lg border border-flexline-border px-3 py-2.5 text-sm text-flexline-navy outline-none ring-flexline-green focus:ring-2"
      >
        <option>Operating · JPM · ···4421 (verified)</option>
      </select>
    </div>

    <section class="rounded-lg border border-flexline-border bg-flexline-table-head/50 p-4 text-sm">
      <h2 class="font-semibold text-flexline-navy">Illustrative preview</h2>
      <p class="mt-2 text-xs text-flexline-muted">
        Fees and instalment breakdown will mirror finance configuration (see PRD open questions).
      </p>
      <dl class="mt-3 grid grid-cols-2 gap-2 text-xs">
        <dt class="text-flexline-muted">Est. fee (demo)</dt>
        <dd class="text-right font-semibold text-flexline-navy">$312.50</dd>
        <dt class="text-flexline-muted">First due</dt>
        <dd class="text-right font-semibold text-flexline-navy">May 15, 2026</dd>
      </dl>
    </section>

    <div class="flex flex-wrap gap-3">
      <input
        type="submit"
        value="Submit draw request"
        class="cursor-pointer rounded-lg bg-flexline-green px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-flexline-green-hover"
      />
      <%= link_to "Cancel", root_path, class: "rounded-lg px-4 py-2.5 text-sm font-semibold text-flexline-navy hover:bg-flexline-sidebar" %>
    </div>
  <% end %>
</div>
