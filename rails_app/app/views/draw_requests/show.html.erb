<div class="mx-auto max-w-2xl space-y-4">
  <div>
    <h1 class="text-xl font-bold text-flexline-navy"><%= @draw.public_code %></h1>
    <p class="mt-1 text-sm text-flexline-muted">
      <%= format_money(@draw.amount_cents) %> · <%= @draw.term_months %> months · <%= @draw.status.titleize %>
    </p>
    <% if @draw.status == "processing" %>
      <p class="mt-2 rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-xs text-violet-950">
        Operations is reviewing this draw. You will get an email when it is funded or declined.
      </p>
    <% elsif @draw.status == "declined" && @draw.decline_reason.present? %>
      <p class="mt-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-950">
        <strong>Update:</strong> <%= @draw.decline_reason %>
      </p>
    <% end %>
  </div>

  <section class="rounded-xl border border-flexline-border bg-white p-5 shadow-card">
    <h2 class="text-sm font-semibold text-flexline-navy">Instalments</h2>
    <% if @draw.installments.any? %>
      <ul class="mt-3 space-y-2 text-sm">
        <% @draw.installments.order(:sequence).each do |i| %>
          <li class="flex items-center justify-between gap-3 border-b border-flexline-border py-2 last:border-0">
            <span class="text-flexline-muted"><%= l(i.due_on) %></span>
            <span class="font-semibold text-flexline-navy"><%= format_money(i.amount_cents) %></span>
            <span class="text-xs text-flexline-muted"><%= i.status.titleize %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-flexline-muted">No instalments found.</p>
    <% end %>
  </section>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-flexline-border pt-4 text-sm">
    <%= link_to "Back to dashboard", root_path, class: "font-semibold text-flexline-green hover:underline" %>
    <%= link_to "Repayment schedule", repayments_path, class: "font-semibold text-flexline-green hover:underline" %>
    <%= link_to "Bank accounts", bank_accounts_path, class: "font-semibold text-flexline-green hover:underline" %>
    <%= link_to "Request another draw", new_draw_request_path, class: "font-semibold text-flexline-green hover:underline" %>
  </div>
</div>
