<% org = @organization %>
<% limit = org.credit_limit_cents.to_i %>
<% available = org.available_for_draws_cents.to_i %>
<% outstanding = org.outstanding_principal_cents.to_i %>
<% pct = limit.positive? ? ((available.to_f / limit) * 360).round : 0 %>

<div class="mx-auto max-w-6xl space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-flexline-navy">Dashboard</h1>
      <p class="mt-1 text-sm text-flexline-muted">
        View your facility, request draws, and track repayments.
      </p>
    </div>
    <%= link_to new_draw_request_path, class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-flexline-green px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-flexline-green-hover" do %>
      Request draw <span aria-hidden="true">›</span>
    <% end %>
  </div>

  <div class="grid items-stretch gap-4 lg:grid-cols-3">
    <section class="flex flex-col rounded-xl border border-flexline-border bg-white p-5 shadow-card lg:col-span-2">
      <h2 class="text-sm font-semibold text-flexline-navy">Available credit</h2>
      <div class="mt-4 flex flex-1 flex-wrap items-center gap-8">
        <div
          class="relative grid h-28 w-28 shrink-0 place-items-center rounded-full"
          style="background: conic-gradient(#2BB673 0deg <%= pct %>deg, #e3eef6 <%= pct %>deg 360deg);"
          aria-hidden="true"
        >
          <div
            class="absolute inset-2 grid place-items-center rounded-full bg-white text-center text-xs font-semibold text-flexline-navy shadow-inner"
          >
            <div>
              <div class="text-lg leading-tight"><%= format_money(available) %></div>
              <div class="text-[10px] font-normal text-flexline-muted">of <%= format_money(limit) %></div>
            </div>
          </div>
        </div>
        <div class="min-w-0 flex-1 space-y-2 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-flexline-muted">Outstanding</span>
            <span class="font-semibold text-flexline-navy"><%= format_money(outstanding) %></span>
          </div>
          <p class="text-[11px] leading-snug text-flexline-muted">
            Unpaid principal on funded draws (repayment schedule). Zero if you have never had a funded draw.
          </p>
          <div class="flex justify-between gap-4 border-t border-flexline-border pt-2">
            <span class="text-flexline-muted">Available</span>
            <span class="font-semibold text-flexline-green"><%= format_money(available) %></span>
          </div>
          <%= link_to "View repayment schedule ›", repayments_path, class: "inline-block pt-2 text-sm font-semibold text-flexline-green hover:underline" %>
        </div>
      </div>
    </section>

    <section class="flex flex-col rounded-xl border border-sky-100 bg-sky-50/80 p-5 shadow-card">
      <div class="flex flex-1 items-start gap-3">
        <div class="shrink-0 rounded-lg bg-white p-2 text-flexline-navy shadow-sm">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 22a2 2 0 002-2H10a2 2 0 002 2zm6-6V11a6 6 0 10-12 0v5l-2 2v1h16v-1l-2-2z"
            />
          </svg>
        </div>
        <div class="min-w-0">
          <h2 class="text-sm font-semibold text-flexline-navy">Notifications</h2>
          <p class="mt-2 text-xs leading-relaxed text-flexline-muted">
            Your recent notifications will appear here.
          </p>
        </div>
      </div>
    </section>
  </div>

  <div class="grid items-stretch gap-4 md:grid-cols-2">
    <section class="flex min-h-[11rem] flex-col rounded-xl border border-flexline-border bg-white p-5 shadow-card">
      <h2 class="text-sm font-semibold text-flexline-navy">Bank accounts</h2>
      <p class="mt-1 flex-1 text-xs leading-relaxed text-flexline-muted">
        Add and verify accounts for disbursement.
      </p>
      <%= link_to "Manage bank accounts ›", bank_accounts_path, class: "mt-4 inline-flex w-fit items-center justify-center gap-2 rounded-lg border border-flexline-green bg-white px-4 py-2.5 text-sm font-semibold text-flexline-green transition hover:bg-emerald-50" %>
    </section>
    <section class="flex min-h-[11rem] flex-col rounded-xl border border-flexline-border bg-white p-5 shadow-card">
      <h2 class="text-sm font-semibold text-flexline-navy">Repayments</h2>
      <p class="mt-1 flex-1 text-xs leading-relaxed text-flexline-muted">
        Instalments created from funded draws (demo schedule; not finance-final).
      </p>
      <%= link_to "Open repayments ›", repayments_path, class: "mt-4 inline-flex w-fit items-center justify-center gap-2 rounded-lg border border-flexline-green bg-white px-4 py-2.5 text-sm font-semibold text-flexline-green transition hover:bg-emerald-50" %>
    </section>
  </div>

  <section class="overflow-hidden rounded-xl border border-flexline-border bg-white shadow-card">
    <div class="border-b border-flexline-border px-4 py-3">
      <h2 class="text-sm font-semibold text-flexline-navy">Recent draws</h2>
    </div>
    <% if @draws.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead>
            <tr class="border-b border-flexline-border bg-slate-50/90 text-xs font-semibold uppercase tracking-wide text-flexline-navy">
              <th class="px-4 py-3">Draw ID</th>
              <th class="px-4 py-3">Amount</th>
              <th class="px-4 py-3">Term</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Last updated</th>
              <th class="px-4 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @draws.each do |draw| %>
              <% variant =
                case draw.status
                when "funded"
                  "rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-900"
                when "processing"
                  "rounded-full border border-violet-200 bg-violet-50 px-2.5 py-0.5 text-xs font-semibold text-violet-900"
                when "declined"
                  "rounded-full border border-rose-200 bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-900"
                else
                  "rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-flexline-navy"
                end %>
              <tr class="border-b border-flexline-border last:border-0">
                <td class="px-4 py-3 font-semibold text-flexline-navy"><%= draw.public_code %></td>
                <td class="px-4 py-3"><%= format_money(draw.amount_cents) %></td>
                <td class="px-4 py-3"><%= draw.term_months %> mo</td>
                <td class="px-4 py-3">
                  <span class="<%= variant %>"><%= draw.status.titleize %></span>
                </td>
                <td class="px-4 py-3 text-flexline-muted"><%= l(draw.updated_at, format: :short) %></td>
                <td class="px-4 py-3 text-right">
                  <%= link_to "View ›", draw_request_path(draw), class: "text-sm font-semibold text-flexline-green hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-4 py-10 text-center text-sm text-flexline-muted">No draws yet.</div>
    <% end %>
  </section>
</div>
