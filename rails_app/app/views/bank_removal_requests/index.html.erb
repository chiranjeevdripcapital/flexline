<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-flexline-navy">Bank removal requests</h1>
    <p class="mt-1 text-sm text-flexline-muted">
      Requests you have submitted for operations to review. Accounts remain active until a request is approved.
    </p>
  </div>

  <section class="rounded-xl border border-flexline-border bg-white p-5 shadow-card">
    <% if @requests.any? %>
      <ul class="divide-y divide-flexline-border">
        <% @requests.each do |r| %>
          <li class="py-4">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <span class="font-semibold text-flexline-navy"><%= r.bank_account.display_name %> · ···<%= r.bank_account.mask_last4 %></span>
              <span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold <%= r.status == "pending_review" ? "border-amber-200 bg-amber-50 text-amber-950" : r.status == "approved" ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-slate-200 bg-slate-50 text-slate-800" %>">
                <%= r.status.titleize.tr("_", " ") %>
              </span>
            </div>
            <p class="mt-2 text-xs text-flexline-muted">Submitted <%= l(r.created_at.to_date) %></p>
            <p class="mt-2 text-sm text-flexline-ink line-clamp-3"><%= r.borrower_reason %></p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-flexline-muted">You have not submitted any removal requests.</p>
    <% end %>
  </section>

  <%= link_to "← Bank accounts", bank_accounts_path, class: "text-sm font-semibold text-flexline-green hover:underline" %>
</div>
