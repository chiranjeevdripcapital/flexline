<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Flexline</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>
  <body class="min-h-screen bg-white font-sans text-flexline-ink">
    <% if flash[:notice] %>
      <div
        class="border-b border-emerald-200 bg-emerald-50 px-6 py-3 text-center text-sm font-medium text-emerald-900"
        role="status"
      >
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div
        class="border-b border-rose-200 bg-rose-50 px-6 py-3 text-center text-sm font-medium text-rose-900"
        role="alert"
      >
        <%= flash[:alert] %>
      </div>
    <% end %>
    <div class="flex min-h-screen">
      <%= render "layouts/sidebar" %>
      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex h-14 items-center justify-end gap-4 border-b border-flexline-border px-6"
        >
          <%= button_to "Sign out", session_path, method: :delete, form_class: "mr-auto inline", class: "text-xs font-semibold text-flexline-muted hover:text-flexline-navy bg-transparent border-0 cursor-pointer p-0" %>
          <span class="rounded-full p-2 text-flexline-muted" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 22a2 2 0 002-2H10a2 2 0 002 2zm6-6V11a6 6 0 10-12 0v5l-2 2v1h16v-1l-2-2z"
              />
            </svg>
          </span>
          <div class="flex items-center gap-2">
            <div class="text-right text-sm leading-tight">
              <div class="font-semibold text-flexline-navy"><%= current_user.email %></div>
              <div class="text-xs text-flexline-muted">Borrower</div>
            </div>
            <div
              class="flex h-9 w-9 items-center justify-center rounded-md bg-flexline-navy text-xs font-bold text-white"
              aria-hidden="true"
            >
              <%= current_user.email.first(2).upcase %>
            </div>
          </div>
        </header>
        <main class="flex-1 bg-slate-50 p-6 lg:p-8"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
