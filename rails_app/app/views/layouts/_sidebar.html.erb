<aside
  class="flex w-64 shrink-0 flex-col border-r border-flexline-border bg-flexline-sidebar"
>
  <div class="border-b border-flexline-border px-4 py-4">
    <div class="text-lg font-bold tracking-tight text-flexline-navy">Flexline</div>
    <p class="mt-3 text-sm font-semibold leading-snug text-flexline-navy">
      <%= current_organization.name %>
    </p>
  </div>
  <nav class="flex flex-1 flex-col gap-0.5 p-2">
    <%= nav_link_to "Dashboard", root_path %>
    <%= nav_link_to "Bank accounts", bank_accounts_path %>
    <%= nav_link_to "Request draw", new_draw_request_path %>
    <%= nav_link_to "Repayments", repayments_path %>
  </nav>
  <div class="border-t border-flexline-border p-4 text-xs text-flexline-muted">
    <div class="font-semibold text-flexline-navy">Need your schedule?</div>
    <div class="mt-2">
      <%= link_to "Open repayment schedule ›", repayments_path, class: "font-semibold text-flexline-green hover:underline" %>
    </div>
  </div>
</aside>
